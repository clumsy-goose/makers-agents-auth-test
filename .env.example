# ─────────────────────────────────────────────────────────────────
# LLM Gateway Configuration
# ─────────────────────────────────────────────────────────────────
# Required: OpenAI-compatible LLM API credentials
AI_GATEWAY_API_KEY=your-api-key
AI_GATEWAY_BASE_URL=https://your-openai-compatible-endpoint/v1

# ─────────────────────────────────────────────────────────────────
# Authentication — RS256 keypair
# ---------------------------------------------------------------------
# Cloud Functions sign tokens with the PRIVATE key; the platform edge
# control plane and the Cloud Functions verify with the PUBLIC key
# (edgeone.json → agents.auth.verificationKeys holds the same public key).
#
# Generate the pair:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
#
# Env vars cannot contain real newlines, so paste the PEM as one line with
# literal \n escapes:
#   awk '{printf "%s\\n", $0}' private_key.pem
#   awk '{printf "%s\\n", $0}' public_key.pem
# ─────────────────────────────────────────────────────────────────
# Required: PEM private key (issuer only — never ship it to the client)
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Required: PEM public key (verifier — same value as edgeone.json)
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Required: Neon Postgres HTTP connection string
# (Neon console → Connection Details → choose "HTTP")
# Format: postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
